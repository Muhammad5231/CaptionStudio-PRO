{
  "name": "captionstudio-pro",
  "version": "1.0.0",
  "private": true,
  "description": "CaptionStudio PRO — Professional AI Video Caption & Subtitle SaaS Platform",
  "author": "CaptionStudio PRO Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @captionstudio/database db:generate",
    "db:push": "pnpm --filter @captionstudio/database db:push",
    "db:studio": "pnpm --filter @captionstudio/database db:studio",
    "db:seed": "pnpm --filter @captionstudio/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
