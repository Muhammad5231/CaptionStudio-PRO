// Prisma Schema for CaptionStudio PRO
// Local development architecture with SQLite

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// USER & IDENTITY MODELS
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  avatarUrl    String?
  role         String   @default("USER") // USER, CREATOR, ADMIN, SUPER_ADMIN
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  timezone     String   @default("UTC")
  language     String   @default("en")

  sessions         Session[]
  workspaceMembers WorkspaceMember[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  supportTickets   SupportTicket[]
  usageLedgers     UsageLedger[]
  uploadIntents    UploadIntent[]
  createdTemplates Template[]       @relation("TemplateCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -----------------------------------------------------------------------------
// WORKSPACE & COLLABORATION
// -----------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  projects      Project[]
  brandKit      BrandKit?
  usageLedger   UsageLedger[]
  uploadIntents UploadIntent[]

  @@index([slug])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("OWNER") // OWNER, ADMIN, EDITOR, VIEWER
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

// -----------------------------------------------------------------------------
// LOCAL DEVELOPMENT PLAN MODEL
// -----------------------------------------------------------------------------

model Plan {
  id                     String   @id @default(cuid())
  tier                   String   @unique @default("FREE") // FREE, CREATOR, PRO, LOCAL
  name                   String   @default("Local Development")
  description            String   @default("Full local development testing plan with all features enabled.")
  monthlyPriceCents      Int      @default(0)
  yearlyPriceCents       Int      @default(0)
  maxProjects            Int      @default(100)
  monthlyTranscribeMins  Int      @default(999999)
  monthlyRenderMins      Int      @default(999999)
  storageLimitBytes      BigInt   @default(107374182400) // 100GB
  maxExportsPerMonth     Int      @default(999999)
  allow4kExport          Boolean  @default(true)
  allow60Fps             Boolean  @default(true)
  allowCustomFonts       Boolean  @default(true)
  allowTeamCollaboration Boolean  @default(true)
  hasWatermark           Boolean  @default(false)
  isActive               Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// PROJECTS & MEDIA
// -----------------------------------------------------------------------------

model Project {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  description      String?
  status           String   @default("DRAFT") // DRAFT, TRANSCRIBING, READY, PROCESSING, EXPORTED, FAILED, ARCHIVED
  thumbnailUrl     String?
  durationSeconds  Float?
  width            Int?
  height           Int?
  fps              Float?
  activeTemplateId String?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets        ProjectAsset[]
  versions      ProjectVersion[]
  exportJobs    ExportJob[]
  exports       Export[]
  uploadIntents UploadIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
}

model ProjectAsset {
  id              String   @id @default(cuid())
  projectId       String
  type            String   @default("VIDEO") // VIDEO, AUDIO, SUBTITLE, THUMBNAIL, RENDERED_VIDEO, CUSTOM_FONT
  storageKey      String
  url             String
  mimeType        String
  sizeBytes       BigInt
  durationSeconds Float?
  width           Int?
  height          Int?
  fps             Float?

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageObject StorageObject? @relation(fields: [storageKey], references: [key])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([type])
}

model ProjectVersion {
  id             String   @id @default(cuid())
  projectId      String
  versionNumber  Int
  captionPayload String   // Stores word timestamps, tracks, styling, layout JSON string
  changelog      String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

// -----------------------------------------------------------------------------
// TEMPLATES
// -----------------------------------------------------------------------------

model TemplateCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  templates   Template[]
  createdAt   DateTime   @default(now())
}

model Template {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  categoryId          String
  createdById         String?
  isPremium           Boolean  @default(false)
  isOfficial          Boolean  @default(true)
  isPublished         Boolean  @default(true)
  styleConfig         String   // JSON string: Typography, color, stroke, shadow, position
  animationConfig     String   // JSON string: Pop, kinetic-bounce, typewriter, karaoke
  previewText         String   @default("This is how your story gets attention.")
  previewThumbnailUrl String?
  previewVideoUrl     String?
  downloadsCount      Int      @default(0)
  likesCount          Int      @default(0)
  tags                String   @default("[]") // JSON array string for SQLite compatibility

  category  TemplateCategory  @relation(fields: [categoryId], references: [id])
  createdBy User?             @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  TemplateVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isPublished])
  @@index([slug])
}

model TemplateVersion {
  id              String   @id @default(cuid())
  templateId      String
  versionNumber   Int
  styleConfig     String   // JSON string
  animationConfig String   // JSON string
  createdAt       DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
}

// -----------------------------------------------------------------------------
// JOBS & EXPORTS (BULLMQ / ASYNC PROCESSING)
// -----------------------------------------------------------------------------

model ExportJob {
  id           String    @id @default(cuid())
  projectId    String
  type         String    @default("EXPORT") // TRANSCRIPTION, MEDIA_ANALYSIS, THUMBNAIL, RENDER, EXPORT
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  priority     Int       @default(0)
  progress     Int       @default(0) // 0 - 100
  stage        String?
  errorMessage String?
  metadata     String?   // JSON string
  startedAt    DateTime?
  completedAt  DateTime?

  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exportRecord Export?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

model Export {
  id              String    @id @default(cuid())
  projectId       String
  jobId           String    @unique
  url             String
  storageKey      String
  format          String    @default("mp4")
  resolution      String    @default("1080p")
  fps             Int       @default(30)
  sizeBytes       BigInt
  durationSeconds Float

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job     ExportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// USAGE & METERING
// -----------------------------------------------------------------------------

model UsageLedger {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  type        String   @default("TRANSCRIPTION_MINUTES") // TRANSCRIPTION_MINUTES, RENDER_MINUTES, STORAGE_BYTES, EXPORTS_COUNT
  amount      Float
  projectId   String?
  jobId       String?
  eventKey    String?  @unique

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([jobId])
  @@index([eventKey])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// STORAGE ABSTRACTION
// -----------------------------------------------------------------------------

model StorageObject {
  id            String         @id @default(cuid())
  key           String         @unique
  bucket        String
  mimeType      String
  sizeBytes     BigInt
  etag          String?
  projectAssets ProjectAsset[]
  createdAt     DateTime       @default(now())

  @@index([key])
}

// -----------------------------------------------------------------------------
// BRAND KIT & PRESETS
// -----------------------------------------------------------------------------

model BrandKit {
  id             String   @id @default(cuid())
  workspaceId    String   @unique
  logoUrl        String?
  primaryColor   String   @default("#635BFF")
  secondaryColor String   @default("#111827")
  accentColor    String   @default("#10B981")
  fonts          String   @default("[\"Inter\", \"Plus Jakarta Sans\"]") // JSON string for SQLite
  watermarkUrl   String?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  presets   BrandPreset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandPreset {
  id              String   @id @default(cuid())
  brandKitId      String
  name            String
  styleConfig     String   // JSON string
  animationConfig String   // JSON string

  brandKit BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandKitId])
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS, AUDIT & SUPPORT
// -----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM") // SYSTEM, JOB_COMPLETED, JOB_FAILED, BILLING_NOTICE, PROJECT_SHARED
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("OPEN")
  priority  String   @default("NORMAL")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// UPLOAD INTENTS & RELIABILITY
// -----------------------------------------------------------------------------

model UploadIntent {
  id                    String    @id @default(cuid())
  userId                String
  workspaceId           String
  projectId             String
  storageKey            String    @unique
  expectedFileSizeBytes BigInt?
  expectedMimeType      String?
  assetType             String    @default("VIDEO")
  status                String    @default("PENDING") // PENDING, UPLOADING, COMPLETED, EXPIRED, CANCELLED
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([expiresAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     String    // JSON string
  attempts    Int       @default(0)
  publishedAt DateTime?
  availableAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([publishedAt, availableAt])
}
