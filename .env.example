# ==============================================================================
# CaptionStudio PRO — Environment Configuration Template
# Copy this file to .env for development.
# Do NOT commit actual secrets or production keys into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Networking
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# DATABASE_PROVIDER: "supabase" (recommended) or "postgresql"
DATABASE_PROVIDER=supabase

# Transaction-mode connection pooler URL (Supavisor port 6543) for Node API & workers
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection URL (Session pooler or port 5432) used for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional local fallback if running offline via Docker:
# DATABASE_URL="postgresql://captionstudio:captionstudio_dev_password@localhost:5432/captionstudio_db?schema=public"
# DIRECT_URL="postgresql://captionstudio:captionstudio_dev_password@localhost:5432/captionstudio_db?schema=public"

# ------------------------------------------------------------------------------
# Object Storage (Supabase Storage — Private Media Bucket)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER: "supabase" (recommended) or "local" (for offline dev/tests)
STORAGE_PROVIDER=supabase

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# CRITICAL SECURITY RULE: The Service Role Key must NEVER be placed in frontend code
# or prefixed with NEXT_PUBLIC_*. It is strictly for server-side Node.js operations.
SUPABASE_SERVICE_ROLE_KEY=eyJh...[YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY]

# Private media storage bucket name (create in Supabase Dashboard -> Storage)
SUPABASE_STORAGE_BUCKET=captionstudio-media

# Optional local storage path (used only when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=./uploads

# ------------------------------------------------------------------------------
# Queue Broker & Caching (Managed Redis for BullMQ)
# ------------------------------------------------------------------------------
# QUEUE_PROVIDER: "redis"
QUEUE_PROVIDER=redis

# Managed Redis URL (Upstash, Redis Cloud, Aiven, or local).
# Supports rediss:// for TLS-encrypted cloud Redis connections.
# Example: rediss://default:[PASSWORD]@[HOST]:[PORT]
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# Optional local fallback if running offline:
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
AUTH_SECRET=captionstudio_super_secret_jwt_and_session_signing_key_32bytes_min
AUTH_COOKIE_NAME=cs_session
AUTH_SESSION_EXPIRY_DAYS=30
APP_URL=http://localhost:3000

# Rate Limiting (Redis-backed)
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX_REQUESTS=30

# Email Delivery Provider (console for dev, smtp or resend for production)
EMAIL_PROVIDER=console
EMAIL_FROM=security@captionstudio.io
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# Media Processing Engines (FFmpeg, FFprobe & Python Whisper)
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600

# System binary paths (leave empty or set if installed in custom locations)
FFMPEG_PATH=
FFPROBE_PATH=
PYTHON_PATH=
WHISPER_MODEL=base
