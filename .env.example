# ==============================================================================
# CaptionStudio PRO — Environment Configuration Template
# Copy this file to .env or .env.local for development.
# Do NOT commit actual secrets or production keys into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Networking
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# PostgreSQL Database (Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://captionstudio:captionstudio_dev_password@localhost:5432/captionstudio_db?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ Queues
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication, Security & Password Reset
# ------------------------------------------------------------------------------
AUTH_SECRET=captionstudio_super_secret_jwt_and_session_signing_key_32bytes_min
AUTH_COOKIE_NAME=cs_session
AUTH_SESSION_EXPIRY_DAYS=30
APP_URL=http://localhost:3000

# Rate Limiting (Redis-backed)
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX_REQUESTS=30

# Email Delivery Provider (console for dev, smtp/resend for production)
EMAIL_PROVIDER=console
EMAIL_FROM=security@captionstudio.io
EMAIL_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OAuth Providers (Optional in local dev)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# Storage Provider (S3-Compatible or Local Disk)
# ------------------------------------------------------------------------------
# Driver options: "local" (default for dev) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=captionstudio-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/captionstudio-media

# ------------------------------------------------------------------------------
# Billing & Payment Provider (Stripe / LemonSqueezy)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe
PAYMENT_PROVIDER_KEY=sk_test_placeholder_key_for_phase1
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_public_key

# ------------------------------------------------------------------------------
# Media Processing & Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
PYTHON_PATH=python
WHISPER_DEFAULT_MODEL=base


